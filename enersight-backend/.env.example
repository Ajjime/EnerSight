# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# PostgreSQL connection string used by SQLAlchemy (app/database.py)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/enersight

# Optional: enables AI-assisted OCR reading in app/routes/ocr.py
# Leave blank to fall back to the local EasyOCR pipeline only.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
