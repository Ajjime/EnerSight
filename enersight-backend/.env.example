# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/energy_gis_db

# JWT signing key. The backend refuses to start without it.
# Generate your own, never reuse another environment's key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# How long a login stays valid, in minutes. Defaults to 60 when unset.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional. Only needed if the trained OCR checkpoints live outside
# app/ocr_models/weights/. See that folder's README.
# CRNN_CTC_MODEL_PATH=
# TPS_ATTN_MODEL_PATH=
# TPS_CTC_MODEL_PATH=
